# Kalshi API credentials
# KALSHI_API_KEY_ID       : Key ID from Kalshi dashboard (Settings → API → Create Key)
# KALSHI_PRIVATE_KEY_PATH : Path to RSA private key .pem (see setup_kalshi_key.py)
KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=/Users/you/.kalshi/private_key.pem
# Demo vs live — match the host to the account you are using
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_ORDER_URL=https://demo-api.kalshi.co/trade-api/v2
REQUIRE_KALSHI_CREDENTIALS=0
KALSHI_SERIES=KXNBAREB

# Model (see bakeoff.py / SYSTEM.md for how the family was chosen)
MODEL_FAMILY=c7_ens_c4_c5
EVAL_LINES=3.5,5.5,7.5,9.5,11.5,13.5
USE_OOF_CALIBRATION=true

# Market blend — fitted weights in models/blend_meta*.json win; don't override w by hand
# without full-slate evidence (mlb_tb_line SYSTEM.md §8).
USE_MARKET_BLEND=true
MIN_BLEND_WEIGHT=0.05
BLEND_REFIT_LOOKBACK_DAYS=30
BLEND_REFIT_LAG_DAYS=2

# Fees / execution
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0.0
MAKER_MODE=true
SCAN_WITHIN_HOURS=1.5

# Edge detection & sizing (conservative small-live starting point)
EDGE_THRESHOLD=0.05
KELLY_FRACTION=0.10
MAX_BET_PCT=0.02
MIN_P=0.20
TAIL_P_CUTOFF=0.30
TAIL_EDGE_MULT=2.0
MIN_LIMIT_PRICE=0.20
# NBA-specific blocks/caps start empty — set only from NBA evidence (segment-report, market_eval)
BLOCKED_SEGMENTS=
MAX_YES_LINE=99
RISKY_BAND_KELLY_MULT=1.0

# Live risk desk
USE_LIVE_BALANCE=true
DAILY_LOSS_LIMIT_PCT=0.10
MAX_ORDERS_PER_DAY=20
MAX_DAILY_DEPLOYED_PCT=0.20
MAX_OPEN_RESTING_PCT=0.10
MAX_CONTRACTS_PER_GAME=30
MAX_LEGS_PER_PLAYER_DAY=2
RESERVE_RESTING_FROM_BANKROLL=true
AUTO_KILL_ON_RISK_BREACH=true
KILL_SWITCH_PATH=data/KILL_SWITCH

# Calibration preflight. Cold start has no fills, so the fill-based calibrator can't exist yet;
# the OOF calibrator (refit on every train) covers it. Flip to 1 once `calibrate` has run.
CALIBRATE_MAX_AGE_DAYS=14
REQUIRE_FILL_CALIB_FOR_LIVE=0

# Backtest
BACKTEST_FILL_MODEL=true

# Segment health (segment-report go/no-go)
SEGMENT_MIN_FILLS=5
SEGMENT_MIN_FILL_RATE=0.25
SEGMENT_MIN_AVG_CLV=0.0
SEGMENT_MIN_ROI_PCT=-5.0
SEGMENT_REPORT_LOOKBACK_DAYS=14

# Storage / ops
DB_PATH=data/nba_reb.db
SEASONS=2021-22,2022-23,2023-24,2024-25,2025-26,2026-27
STRUCTURED_LOG=0
